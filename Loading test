
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Amethyst Pro. Loader</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #111;
}

#initializer {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
    border: none;
}

#destination {
    width: 100%;
    height: 100%;
    border: none;
}
</style>
</head>

<body>

<!-- Invisible Amethyst iframe -->
<iframe
    id="initializer"
    src="https://amethyst.zone/browse"
></iframe>

<!-- Visible destination iframe -->
<iframe
    id="destination"
    src="https://amethyst.zone/scram/service/https%3A%2F%2Fwww.google.com"
></iframe>

</body>
</html>
